{
    "name": "lektrail/lektrail",
    "description": "Track reading progress and suggest unread posts",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^2.1",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.94"
    },
    "autoload": {
        "psr-4": {
            "LekTrail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LekTrail\\Tests\\": "tests/php/",
            "LekTrail\\Tests\\Mocks\\": "tests/php/Mocks/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "php-cs-fixer fix",
        "format-check": "php-cs-fixer fix --dry-run --diff"
    }
}
